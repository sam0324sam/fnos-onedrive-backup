# ================================================================
# fnOS 雙集群 3-2-1 備份 Rclone 配置範本 (rclone.conf.example)
# 請複製此檔為 rclone.conf，並填入實際 Token 與加密密鑰
# ================================================================

# ---------- 集群 1 (主儲存 OD1 Pool) ----------
[od1_1]
type = onedrive
drive_id = YOUR_DRIVE_ID_1
drive_type = business
token = {"access_token":"YOUR_ACCESS_TOKEN","token_type":"Bearer","refresh_token":"YOUR_REFRESH_TOKEN","expiry":"2026-09-06T18:00:00.0000000+08:00"}
access_scopes = Files.Read Files.ReadWrite offline_access

# [虛擬合流層 - 單帳號 alias 模式]
[od1_union]
type = alias
remote = od1_1:fnOS_Backup

# [多帳號擴充模式 - 方案 A 循序填滿 (Sequential Fill / 溢流模式)]
# 當接入第 2 個帳號 (od1_2) 時，註解上方 alias，改用下方 union 設定：
# [od1_union]
# type = union
# upstreams = od1_1:fnOS_Backup od1_2:fnOS_Backup
# action_policy = epff
# create_policy = ff
# min_free_space = 50G

# [客戶端強加密層 (XSalsa20)]
[od1_crypt]
type = crypt
remote = od1_union:
filename_encryption = off
directory_name_encryption = false
password = YOUR_OBSCURED_PASSWORD

# ---------- 集群 2 (異地鏡像 OD2 Pool) ----------
[od2_1]
type = onedrive
drive_id = YOUR_DRIVE_ID_2
drive_type = business
token = {"access_token":"YOUR_ACCESS_TOKEN","token_type":"Bearer","refresh_token":"YOUR_REFRESH_TOKEN","expiry":"2026-09-06T18:00:00.0000000+08:00"}
access_scopes = Files.Read Files.ReadWrite offline_access

# [虛擬合流層 - 單帳號 alias 模式]
[od2_union]
type = alias
remote = od2_1:fnOS_Backup

# [多帳號擴充模式 - 方案 A 循序填滿 (Sequential Fill / 溢流模式)]
# 當接入第 2 個帳號 (od2_2) 時，註解上方 alias，改用下方 union 設定：
# [od2_union]
# type = union
# upstreams = od2_1:fnOS_Backup od2_2:fnOS_Backup
# action_policy = epff
# create_policy = ff
# min_free_space = 50G

# [鏡像解密測試層 (驗證用)]
[od2_crypt]
type = crypt
remote = od2_union:
filename_encryption = off
directory_name_encryption = false
password = YOUR_OBSCURED_PASSWORD
