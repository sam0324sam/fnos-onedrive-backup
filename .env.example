# ==============================================================================
# 4-3-2 企業級多雲端容災備份系統環境變數設定範本 (.env.example)
# 複製此檔案為 .env 並根據您的 NAS 環境調整
# ==============================================================================

# Telegram Bot 告警通知與互動指令設定 (必填)
# 取得方式：向 @BotFather 申請 Bot Token，並向 @userinfobot 取得您的個人 Chat ID
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ----------------- 本地儲存路徑自訂 (依您的 NAS 系統調整) -----------------
# 本地主儲存資料池路徑 (例：fnOS 為 /vol1，群暉 Synology 為 /volume1，威聯通 QNAP 為 /share/CACHEDEV1_DATA)
NAS_DATA_DIR=/vol1

# Docker 服務設定檔所在目錄 (供每日 GFS 階梯快照備份，若無可留空或略過)
DOCKER_SRC_DIR=/vol2/1000/docker

# 系統盤災難復原隨身碟掛載點 (選用，供裸機時光機備份)
SYSTEM_BACKUP_DIR=/mnt/system_backup

# 自訂欲備份的資料夾清單 (逗號分隔，例: photo,documents,video；留空則自動探索 /data 下所有目錄)
# BACKUP_FOLDERS=photo,documents,video

# ----------------- 守衛與排程參數 -----------------
# 雲端儲存池剩餘容量告警門檻 (單位: GB)
FREE_THRESHOLD_GB=100.0

# 每日自動全量同步排程時間 (HH:MM，24 小時制)
SYNC_SCHEDULE_TIME=02:00

